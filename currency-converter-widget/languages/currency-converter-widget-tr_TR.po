msgstr "Sıkça Sorulan Sorular"

#: currency-converter-widget.php
msgid "How do I add a currency converter to my page?"
msgstr "Sayfama bir döviz çevirici nasıl eklerim?"

#: currency-converter-widget.php
msgid "Use the shortcode [currencywiki_converter] or add the Currency Kit block in the Gutenberg editor."
msgstr "[currencywiki_converter] kısa kodunu kullanın veya Gutenberg editöründe Currency Kit bloğunu ekleyin."

#: currency-converter-widget.php
msgid "Can I customize the widget colors?"
msgstr "Widget renklerini özelleştirebilir miyim?"

#: currency-converter-widget.php
msgid "Yes! Go to Currency Kit → Dashboard and select your preferred accent color from the color palette."
msgstr "Evet! Currency Kit → Kontrol Paneli'ne gidin ve renk paletinden tercih ettiğiniz vurgulu rengi seçin."

#: currency-converter-widget.php
msgid "How often are exchange rates updated?"
msgstr "Döviz kurları ne sıklıkla güncelleniyor?"

#: currency-converter-widget.php
msgid "Exchange rates are updated in real-time from Currency.Wiki API."
msgstr "Döviz kurları, Currency.Wiki API'sinden gerçek zamanlı olarak güncellenmektedir."

#: currency-converter-widget.php
msgid "Need More Help?"
msgstr "Daha Fazla Yardıma İhtiyacınız Var mı?"

#: currency-converter-widget.php
msgid "Contact our support team or visit our documentation for more information."
msgstr "Destek ekibimizle iletişime geçin veya daha fazla bilgi için belgelerimizi ziyaret edin."

#: currency-converter-widget.php
msgid "Get Support"
msgstr "Destek Al"

#: currency-converter-widget.php
msgid "Display currency converter on your sidebar. (Legacy V2 widget - consider using the Gutenberg block instead)"
msgstr "Döviz çeviriciyi kenar çubuğunuzda görüntüleyin. (Eski V2 widget - bunun yerine Gutenberg bloğunu kullanmayı düşünün)"

#: currency-converter-widget.php
msgid "Currency Converter Widget (Legacy)"
msgstr "Döviz Çevirici Widget'ı (Eski)"

#: currency-converter-widget.php
msgid "Legacy Widget"
msgstr "Eski Widget"

