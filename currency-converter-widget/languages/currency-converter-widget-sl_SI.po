msgid "Use the shortcode [currencywiki_converter] or add the Currency Kit block in the Gutenberg editor."
msgstr "Uporabite kratko kodo [currencywiki_converter] ali dodajte Currency Kit blok v Gutenberg urejevalniku."

#: currency-converter-widget.php
msgid "Can I customize the widget colors?"
msgstr "Ali lahko prilagodim barve pripomočka?"

#: currency-converter-widget.php
msgid "Yes! Go to Currency Kit → Dashboard and select your preferred accent color from the color palette."
msgstr "Da! Pojdite na Currency Kit → Nadzorna plošča in izberite svojo najljubšo barvo iz barvne palete."

#: currency-converter-widget.php
msgid "How often are exchange rates updated?"
msgstr "Kako pogosto se posodabljajo tečaji?"

#: currency-converter-widget.php
msgid "Exchange rates are updated in real-time from Currency.Wiki API."
msgstr "Tečaji se posodabljajo v realnem času iz Currency.Wiki API."

#: currency-converter-widget.php
msgid "Need More Help?"
msgstr "Potrebujete več pomoči?"

#: currency-converter-widget.php
msgid "Contact our support team or visit our documentation for more information."
msgstr "Kontaktirajte našo podporo ali obiščite našo dokumentacijo za več informacij."

#: currency-converter-widget.php
msgid "Get Support"
msgstr "Pridobite podporo"

#: currency-converter-widget.php
msgid "Display currency converter on your sidebar. (Legacy V2 widget - consider using the Gutenberg block instead)"
msgstr "Prikažite pretvornik valut na svoji stranski vrstici. (Zastareli V2 pripomoček - razmislite o uporabi Gutenberg bloka namesto tega)"

#: currency-converter-widget.php
msgid "Currency Converter Widget (Legacy)"
msgstr "Pripomoček za pretvornik valut (zastareli)"

#: currency-converter-widget.php
msgid "Legacy Widget"
msgstr "Zastareli pripomoček"

#: currency-converter-widget.php
msgid "This is a legacy V2 widget. For more features and better customization, use the new Currency Converter block in the Gutenberg editor."
msgstr "To je zastareli V2 pripomoček. Za več funkcij in boljšo prilagoditev uporabite nov blok za pretvornik valut v Gutenberg urejevalniku."

