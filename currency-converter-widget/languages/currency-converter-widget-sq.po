#: currency-converter-widget.php
msgid "Use the <strong>[currencywiki_converter]</strong> shortcode to add widgets to posts and pages"
msgstr "Përdorni <strong>[currencywiki_converter]</strong> shortcode për të shtuar widget-e në postime dhe faqe"

#: currency-converter-widget.php
msgid "Customize the widget style, theme, and colors from the Dashboard"
msgstr "Personalizoni stilin e widget-it, temën dhe ngjyrat nga Paneli i Kontrollit"

#: currency-converter-widget.php
msgid "Use the Currency Kit block in the Gutenberg editor for visual editing"
msgstr "Përdorni bllokun Currency Kit në redaktuesin Gutenberg për redaktim vizual"

#: currency-converter-widget.php
msgid "Copy the embed code to use on external websites"
msgstr "Kopjoni kodin e integrimit për ta përdorur në faqet e jashtme"

#: currency-converter-widget.php
msgid "Frequently Asked Questions"
msgstr "Pyetje të Bëra Shpesh"

#: currency-converter-widget.php
msgid "How do I add a currency converter to my page?"
msgstr "Si mund të shtoj një konvertues monedhe në faqen time?"

#: currency-converter-widget.php
msgid "Use the shortcode [currencywiki_converter] or add the Currency Kit block in the Gutenberg editor."
msgstr "Përdorni shortcode [currencywiki_converter] ose shtoni bllokun Currency Kit në redaktuesin Gutenberg."

#: currency-converter-widget.php
msgid "Can I customize the widget colors?"
msgstr "A mund të personalizoj ngjyrat e widget-it?"

#: currency-converter-widget.php
msgid "Yes! Go to Currency Kit → Dashboard and select your preferred accent color from the color palette."
msgstr "Po! Shkoni te Currency Kit → Paneli i Kontrollit dhe zgjidhni ngjyrën tuaj të preferuar nga paleta e ngjyrave."

#: currency-converter-widget.php
msgid "How often are exchange rates updated?"
msgstr "Sa shpesh përditësohen normat e këmbimit?"

#: currency-converter-widget.php
msgid "Exchange rates are updated in real-time from Currency.Wiki API."
msgstr "Normat e këmbimit përditësohen në kohë reale nga API e Currency.Wiki."

#: currency-converter-widget.php
msgid "Need More Help?"
msgstr "Keni Nevojë për Më shumë Ndihmë?"

#: currency-converter-widget.php
msgid "Contact our support team or visit our documentation for more information."
msgstr "Kontaktoni ekipin tonë të mbështetjes ose vizitoni dokumentacionin tonë për më shumë informacion."

#: currency-converter-widget.php
msgid "Get Support"
msgstr "Merrni Mbështetje"

#: currency-converter-widget.php
msgid "Display currency converter on your sidebar. (Legacy V2 widget - consider using the Gutenberg block instead)"
msgstr "Shfaqni konvertuesin e monedhës në anën tuaj. (Widget-i Legacy V2 - merrni parasysh përdorimin e bllokut Gutenberg në vend)"

#: currency-converter-widget.php
msgid "Currency Converter Widget (Legacy)"
msgstr "Widget-i i Konvertuesit të Monedhës (Legacy)"

#: currency-converter-widget.php
msgid "Legacy Widget"
msgstr "Widget-i Legacy"

#: currency-converter-widget.php
msgid "This is a legacy V2 widget. For more features and better customization, use the new Currency Converter block in the Gutenberg editor."
msgstr "Ky është një widget Legacy V2. Për më shumë veçori dhe personalizim më të mirë, përdorni bllokun e ri të Konvertuesit të Monedhës në redaktuesin Gutenberg."

