#: currency-converter-widget.php
msgid "Help & Support"
msgstr "Trợ Giúp & Hỗ Trợ"

#: currency-converter-widget.php
msgid "Get help with Currency Kit"
msgstr "Nhận trợ giúp với Currency Kit"

#: currency-converter-widget.php
msgid "Learn how to use Currency Kit to add beautiful currency converter widgets to your WordPress site."
msgstr "Tìm hiểu cách sử dụng Currency Kit để thêm các widget chuyển đổi tiền tệ đẹp mắt vào trang WordPress của bạn."

#: currency-converter-widget.php
msgid "Use the <strong>[currencywiki_converter]</strong> shortcode to add widgets to posts and pages"
msgstr "Sử dụng shortcode <strong>[currencywiki_converter]</strong> để thêm widget vào bài viết và trang"

#: currency-converter-widget.php
msgid "Customize the widget style, theme, and colors from the Dashboard"
msgstr "Tùy chỉnh kiểu dáng, chủ đề và màu sắc của widget từ Bảng điều khiển"

#: currency-converter-widget.php
msgid "Use the Currency Kit block in the Gutenberg editor for visual editing"
msgstr "Sử dụng block Currency Kit trong trình chỉnh sửa Gutenberg để chỉnh sửa trực quan"

#: currency-converter-widget.php
msgid "Copy the embed code to use on external websites"
msgstr "Sao chép mã nhúng để sử dụng trên các trang web bên ngoài"

#: currency-converter-widget.php
msgid "Frequently Asked Questions"
msgstr "Câu Hỏi Thường Gặp"

#: currency-converter-widget.php
msgid "How do I add a currency converter to my page?"
msgstr "Làm thế nào để tôi thêm một bộ chuyển đổi tiền tệ vào trang của mình?"

#: currency-converter-widget.php
msgid "Use the shortcode [currencywiki_converter] or add the Currency Kit block in the Gutenberg editor."
msgstr "Sử dụng shortcode [currencywiki_converter] hoặc thêm block Currency Kit trong trình chỉnh sửa Gutenberg."

#: currency-converter-widget.php
msgid "Can I customize the widget colors?"
msgstr "Tôi có thể tùy chỉnh màu sắc của widget không?"

#: currency-converter-widget.php
msgid "Yes! Go to Currency Kit → Dashboard and select your preferred accent color from the color palette."
msgstr "Có! Đi đến Currency Kit → Bảng điều khiển và chọn màu sắc ưa thích từ bảng màu."

#: currency-converter-widget.php
msgid "How often are exchange rates updated?"
msgstr "Tần suất cập nhật tỷ giá hối đoái là bao lâu?"

#: currency-converter-widget.php
msgid "Exchange rates are updated in real-time from Currency.Wiki API."
msgstr "Tỷ giá hối đoái được cập nhật theo thời gian thực từ API của Currency.Wiki."

#: currency-converter-widget.php
msgid "Need More Help?"
msgstr "Cần thêm trợ giúp?"

#: currency-converter-widget.php
msgid "Contact our support team or visit our documentation for more information."
msgstr "Liên hệ với đội ngũ hỗ trợ của chúng tôi hoặc truy cập tài liệu của chúng tôi để biết thêm thông tin."

#: currency-converter-widget.php
msgid "Get Support"
msgstr "Nhận Hỗ Trợ"

#: currency-converter-widget.php
msgid "Display currency converter on your sidebar. (Legacy V2 widget - consider using the Gutenberg block instead)"
msgstr "Hiển thị bộ chuyển đổi tiền tệ trên thanh bên của bạn. (Widget V2 cũ - hãy xem xét sử dụng block Gutenberg thay thế)"

#: currency-converter-widget.php
msgid "Currency Converter Widget (Legacy)"
msgstr "Widget Chuyển Đổi Tiền Tệ (Cũ)"

#: currency-converter-widget.php
