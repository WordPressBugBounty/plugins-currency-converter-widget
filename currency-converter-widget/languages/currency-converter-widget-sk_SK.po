msgid "How do I add a currency converter to my page?"
msgstr "Ako pridám konvertor mien na svoju stránku?"

#: currency-converter-widget.php
msgid "Use the shortcode [currencywiki_converter] or add the Currency Kit block in the Gutenberg editor."
msgstr "Použite skratku [currencywiki_converter] alebo pridajte blok Currency Kit v editore Gutenberg."

#: currency-converter-widget.php
msgid "Can I customize the widget colors?"
msgstr "Môžem prispôsobiť farby widgetu?"

#: currency-converter-widget.php
msgid "Yes! Go to Currency Kit → Dashboard and select your preferred accent color from the color palette."
msgstr "Áno! Prejdite na Currency Kit → Ovládací panel a vyberte si preferovanú akcentovú farbu z palety farieb."

#: currency-converter-widget.php
msgid "How often are exchange rates updated?"
msgstr "Ako často sa aktualizujú výmenné kurzy?"

#: currency-converter-widget.php
msgid "Exchange rates are updated in real-time from Currency.Wiki API."
msgstr "Výmenné kurzy sa aktualizujú v reálnom čase z Currency.Wiki API."

#: currency-converter-widget.php
msgid "Need More Help?"
msgstr "Potrebujete ďalšiu pomoc?"

#: currency-converter-widget.php
msgid "Contact our support team or visit our documentation for more information."
msgstr "Kontaktujte náš tím podpory alebo navštívte našu dokumentáciu pre viac informácií."

#: currency-converter-widget.php
msgid "Get Support"
msgstr "Získať podporu"

#: currency-converter-widget.php
msgid "Display currency converter on your sidebar. (Legacy V2 widget - consider using the Gutenberg block instead)"
msgstr "Zobrazte konvertor mien na svojom bočnom paneli. (Dedičná V2 widget - zvážte použitie bloku Gutenberg namiesto toho)"

#: currency-converter-widget.php
msgid "Currency Converter Widget (Legacy)"
msgstr "Widget na konverziu mien (dedičný)"

#: currency-converter-widget.php
msgid "Legacy Widget"
msgstr "Dedičný widget"

#: currency-converter-widget.php
msgid "This is a legacy V2 widget. For more features and better customization, use the new Currency Converter block in the Gutenberg editor."
msgstr "Toto je dedičný V2 widget. Pre viac funkcií a lepšie prispôsobenie použite nový blok konvertora mien v editore Gutenberg."

