msgid "Open the block editor in any post or page"
msgstr "Ар кандай пост же бетте блок редакторун ачыңыз"

#: templates/admin-page.php
msgid "Click the + button to add a new block"
msgstr "Жаңы блок кошуу үчүн + баскычын басыңыз"

#: templates/admin-page.php
msgid "Search for \\"Currency Converter\\""
msgstr "Кирүү үчүн \\"Валюта Конвертер\\" издеңиз"

#: templates/admin-page.php
msgid "Configure the widget in the block settings sidebar"
msgstr "Блоктун жөндөөлөр панелинде виджетти конфигурациялаңыз"

#: templates/admin-page.php
msgid "Need Help?"
msgstr "Жардам керекпи?"

#: templates/admin-page.php
msgid "Visit our documentation or contact support for assistance."
msgstr "Биздин документацияга кирип же жардам үчүн колдоо менен байланышсаңыз болот."

