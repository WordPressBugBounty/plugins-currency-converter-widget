msgstr "Käytä lyhennettä [currencywiki_converter] tai lisää Currency Kit -lohko Gutenberg-editorissa."

#: currency-converter-widget.php
msgid "Can I customize the widget colors?"
msgstr "Voinko mukauttaa widgetin värejä?"

#: currency-converter-widget.php
msgid "Yes! Go to Currency Kit → Dashboard and select your preferred accent color from the color palette."
msgstr "Kyllä! Siirry Currency Kit → Hallintapaneeliin ja valitse haluamasi korostusväri väripalettista."

#: currency-converter-widget.php
msgid "How often are exchange rates updated?"
msgstr "Kuinka usein vaihtokurssit päivitetään?"

#: currency-converter-widget.php
msgid "Exchange rates are updated in real-time from Currency.Wiki API."
msgstr "Vaihtokurssit päivitetään reaaliajassa Currency.Wiki API:sta."

#: currency-converter-widget.php
msgid "Need More Help?"
msgstr "Tarvitsetko lisää apua?"

#: currency-converter-widget.php
msgid "Contact our support team or visit our documentation for more information."
msgstr "Ota yhteyttä tukitiimiimme tai vieraile asiakirjoissamme saadaksesi lisätietoja."

#: currency-converter-widget.php
msgid "Get Support"
msgstr "Hanki tukea"

#: currency-converter-widget.php
msgid "Display currency converter on your sidebar. (Legacy V2 widget - consider using the Gutenberg block instead)"
msgstr "Näytä valuuttamuunnin sivupalkissasi. (Perinteinen V2-widget - harkitse Gutenberg-lohkon käyttöä sen sijaan)"

#: currency-converter-widget.php
msgid "Currency Converter Widget (Legacy)"
msgstr "Valuuttamuunnin-widget (perinteinen)"

