msgstr "Kopa ikhowudi yokuhlanganisa ukuyisebenzisa kwiwebhusayithi zangaphandle"

#: currency-converter-widget.php
msgid "Frequently Asked Questions"
msgstr "Imibuzo Ebuzwa Ng frequently"

#: currency-converter-widget.php
msgid "How do I add a currency converter to my page?"
msgstr "Ndingenza njani ukuba ndingeze umguquli wemali kwiiphepha zam?"

#: currency-converter-widget.php
msgid "Use the shortcode [currencywiki_converter] or add the Currency Kit block in the Gutenberg editor."
msgstr "Sebenzisa i-shortcode [currencywiki_converter] okanye wongeze i-Currency Kit block kwi-Gutenberg editor."

#: currency-converter-widget.php
msgid "Can I customize the widget colors?"
msgstr "Ngaba ndingalungisa imibala yeewijethi?"

#: currency-converter-widget.php
msgid "Yes! Go to Currency Kit → Dashboard and select your preferred accent color from the color palette."
msgstr "Ewe! Iya kwi-Currency Kit → Dashboard kwaye ukhethe umbala wakho owuthandayo kwi-palette yemibala."

#: currency-converter-widget.php
msgid "How often are exchange rates updated?"
msgstr "Ngaba iimeko zokutshintsha zihlaziywa kangakanani?"

#: currency-converter-widget.php
msgid "Exchange rates are updated in real-time from Currency.Wiki API."
msgstr "Iimeko zokutshintsha zihlaziywa ngexesha lokwenyani kwi-Currency.Wiki API."

#: currency-converter-widget.php
msgid "Need More Help?"
msgstr "Ufunani Uncedo Olungakumbi?"

#: currency-converter-widget.php
msgid "Contact our support team or visit our documentation for more information."
msgstr "Xhumana neqela lethu leenkxaso okanye uvakashele imibhalo yethu ukuze ufumane ulwazi olungakumbi."

#: currency-converter-widget.php
msgid "Get Support"
msgstr "Fumana Inkxaso"

#: currency-converter-widget.php
msgid "Display currency converter on your sidebar. (Legacy V2 widget - consider using the Gutenberg block instead)"
msgstr "Bonisa umguquli wemali kwi-sidebar yakho. (Legacy V2 widget - qwalasela ukusebenzisa i-Gutenberg block endaweni)"

#: currency-converter-widget.php
msgid "Currency Converter Widget (Legacy)"
