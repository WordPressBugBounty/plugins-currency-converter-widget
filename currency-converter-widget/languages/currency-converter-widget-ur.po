msgstr "مکمل خصوصیات والا ویجیٹ جس میں ڈراپ ڈاؤن مینو ہیں جو ارد گرد کے مواد کے سامنے ظاہر ہوتے ہیں۔ انٹرایکٹو کرنسی انتخاب کے لیے بہترین."

#: templates/admin-page.php
msgid "Iframe Embed (Fallback Option)"
msgstr "آئی فریم ایمبیڈ (متبادل آپشن)"

#: templates/admin-page.php
msgid "Use this if the script embed causes conflicts with your website. Works in isolated sandbox."
msgstr "اگر اسکرپٹ ایمبیڈ آپ کی ویب سائٹ کے ساتھ تنازعات پیدا کرتا ہے تو یہ استعمال کریں۔ الگ تھلگ سینڈ باکس میں کام کرتا ہے."

#: templates/admin-page.php
msgid "Limitations:"
msgstr "محدودات:"

