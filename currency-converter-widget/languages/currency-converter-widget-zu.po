msgid "Frequently Asked Questions"
msgstr "Imibuzo Ebuzwa Njalo"

#: currency-converter-widget.php
msgid "How do I add a currency converter to my page?"
msgstr "Ngiyifaka kanjani i-converter yokushintsha imali ekhasini lami?"

#: currency-converter-widget.php
msgid "Use the shortcode [currencywiki_converter] or add the Currency Kit block in the Gutenberg editor."
msgstr "Sebenzisa i-shortcode [currencywiki_converter] noma ungeze ibhulokhi ye-Currency Kit ku-Gutenberg editor."

#: currency-converter-widget.php
msgid "Can I customize the widget colors?"
msgstr "Ngiyakwazi yini ukulungisa imibala ye-widget?"

#: currency-converter-widget.php
msgid "Yes! Go to Currency Kit → Dashboard and select your preferred accent color from the color palette."
msgstr "Yebo! Iya ku-Currency Kit → Dashboard bese ukhetha umbala wakho owuthandayo ohlwini lwemibala."

#: currency-converter-widget.php
msgid "How often are exchange rates updated?"
msgstr "Kanjani izinga lokushintshaniswa lihlaziywa?"

#: currency-converter-widget.php
msgid "Exchange rates are updated in real-time from Currency.Wiki API."
msgstr "Izinga lokushintshaniswa lihlaziywa ngesikhathi sangempela kusuka ku-Currency.Wiki API."

#: currency-converter-widget.php
msgid "Need More Help?"
msgstr "Udinga Usizo Olungaphezulu?"

#: currency-converter-widget.php
msgid "Contact our support team or visit our documentation for more information."
msgstr "Xhumana neqembu lethu lokusekela noma uvakashele imibhalo yethu ukuze uthole olunye ulwazi."

#: currency-converter-widget.php
msgid "Get Support"
msgstr "Thola Usizo"

#: currency-converter-widget.php
